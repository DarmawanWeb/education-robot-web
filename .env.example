# Public addresses, inlined at build time.
NEXT_PUBLIC_WEB_URL=http://localhost:3003
NEXT_PUBLIC_SIM_URL=http://localhost:3002

# Orders and questions go here. Digits only, with the country code: 628123456789.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Defaults to the address in packages/catalog/src/brand.ts.
NEXT_PUBLIC_EMAIL=

# Store pages on each marketplace. A button only appears once its link is set.
NEXT_PUBLIC_TOKOPEDIA_URL=
NEXT_PUBLIC_SHOPEE_URL=
